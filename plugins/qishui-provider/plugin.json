{
  "id": "com.twilightecho.provider.qishui",
  "name": "汽水音乐音源",
  "version": "0.5.0",
  "description": "汽水音乐原生 Provider：发现主页、推荐歌单、个人音乐库、搜索、封面、歌词与播放音源；支持宿主安全扫码登录。",
  "author": "OpenAI",
  "license": "Apache-2.0",
  "type": ["provider", "ui"],
  "main": "index.mjs",
  "runtimeFiles": [
    "playback.mjs",
    "images.mjs",
    "home.mjs",
    "qishui-auth-v6.cjs",
    "qishui-auth-v6"
  ],
  "engines": {
    "twilightEcho": ">=0.20.0"
  },
  "apiVersion": 1,
  "permissions": ["network", "settings", "ui:inject", "library:read"],
  "androidRuntime": {
    "apiVersion": 2,
    "entry": "android/provider.js",
    "permissions": ["network", "settings"],
    "networkHosts": ["api.qishui.com", "beta-luna.douyin.com", "music.douyin.com"],
    "mediaHosts": ["*.qishui.com", "*.douyin.com", "*.byteplusapi.com", "*.volcengineapi.com", "*.bytedanceapi.com", "*.douyinvod.com", "*.douyinpic.com", "*.douyinstatic.com", "*.zjcdn.com"]
  },
  "repository": "https://github.com/Px-asen/Twilight-Echo-plugins",
  "homepage": "https://github.com/Px-asen/Twilight-Echo-plugins"
}
