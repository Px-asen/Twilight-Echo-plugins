{
  "id": "com.twilightecho.provider.ytmusic",
  "name": "YouTube Music 音源",
  "version": "1.1.0",
  "description": "在 Twilight Echo 流媒体区搜索和播放 YouTube Music 曲库。基于 ytmusicapi 解析逻辑重构，支持搜索、播放、歌词、歌单和用户媒体库。",
  "author": "Px-asen",
  "license": "Apache-2.0",
  "type": ["provider", "ui"],
  "main": "index.mjs",
  "engines": {
    "twilightEcho": ">=0.20.0"
  },
  "apiVersion": 1,
  "permissions": ["network", "settings", "ui:inject", "library:read"],
  "androidRuntime": {
    "apiVersion": 2,
    "entry": "android/provider.js",
    "permissions": ["network", "settings"],
    "networkHosts": ["music.youtube.com", "www.youtube.com", "www.googleapis.com", "oauth2.googleapis.com"],
    "mediaHosts": ["*.googlevideo.com", "*.ytimg.com", "*.ggpht.com", "*.googleusercontent.com"]
  },
  "repository": "https://github.com/Px-asen/Twilight-Echo-plugins",
  "homepage": "https://github.com/Px-asen/Twilight-Echo-plugins"
}
