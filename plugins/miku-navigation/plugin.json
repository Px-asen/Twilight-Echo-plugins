        "editor": {
          "schemaVersion": 1,
          "controls": [
            {
              "id": "wall-image",
              "label": "全局背景图片",
              "group": "全局背景",
              "variable": "--miku-wall-image",
              "type": "image",
              "defaults": {
                "pureWhite": "none",
                "dark": "none"
              }
            },
            {
              "id": "wall-wash",
              "label": "背景蒙版",
              "group": "全局背景",
              "variable": "--miku-wall-wash",
              "type": "number",
              "defaults": {
                "pureWhite": "33%",
                "dark": "43%"
              },
              "unit": "%",
              "min": 0,
              "max": 100
            },
            {
              "id": "wall-position",
              "label": "背景位置",
              "group": "全局背景",
              "variable": "--miku-wall-position",
              "type": "text",
              "defaults": {
                "pureWhite": "center 42%",
                "dark": "center 42%"
              }
            },
            {
              "id": "wall-size",
              "label": "背景缩放",
              "group": "全局背景",
              "variable": "--miku-wall-size",
              "type": "select",
              "defaults": {
                "pureWhite": "cover",
                "dark": "cover"
              },
              "options": [
                "cover",
                "contain",
                "100% auto",
                "auto 100%"
              ]
            },
            {
              "id": "home-wall-wash",
              "label": "首页背景蒙版",
              "group": "全局背景",
              "variable": "--miku-wall-wash",
              "type": "number",
              "defaults": {
                "pureWhite": "50%",
                "dark": "50%"
              },
              "selector": "body:has(.app-shell):has(.home)",
              "unit": "%",
              "min": 0,
              "max": 100
            },
            {
              "id": "settings-wall-wash",
              "label": "设置背景蒙版",
              "group": "设置",
              "variable": "--miku-wall-wash",
              "type": "number",
              "defaults": {
                "pureWhite": "53%",
                "dark": "53%"
              },
              "selector": "body:has(.app-shell) .settings-overlay-root--active",
              "unit": "%",
              "min": 0,
              "max": 100
