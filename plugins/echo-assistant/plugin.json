{
  "id": "com.twilightecho.assistant.echo",
  "name": "回声助手",
  "version": "0.2.0",
  "description": "音乐助手：在插件面板内完成本地曲库体检、重复对比和 AI 跟进，支持角色提示词、快捷指令、主题歌单及确认后修改设置与元数据。可接入 OpenAI Chat/Responses、Claude 及兼容 API。",
  "author": "Pxasen",
  "license": "Apache-2.0",
  "type": [
    "ui",
    "tool"
  ],
  "main": "gateway.mjs",
  "runtimeFiles": [
    "agent",
    "ui-dist"
  ],
  "engines": {
    "twilightEcho": ">=1.3.1"
  },
  "apiVersion": 4,
  "permissions": [
    "network",
    "ui:inject",
    "settings",
    "app:settings",
    "library:read",
    "library:write",
    "player:observe",
    "player:control"
  ],
  "contributes": {
    "experiences": [
      {
        "id": "chat",
        "name": "回声助手",
        "entry": "ui-dist/index.html",
        "bridgeVersion": 2,
        "launch": "panel"
      }
    ]
  },
  "repository": "https://github.com/Px-asen/Twilight-Echo-plugins",
  "homepage": "https://github.com/Px-asen/Twilight-Echo-plugins/tree/main/plugins/echo-assistant"
}
